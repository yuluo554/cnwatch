        }
      ],
      "expect": {
        "stock_failed": "total_mismatch",
        "stored": 0
      }
    },
    {
      "id": "empty_page",
      "what": "a stock with no filings that day",
      "rows": [],
      "expect": {
        "stored": 0,
        "stock_ok": true
      }
    }
  ]
